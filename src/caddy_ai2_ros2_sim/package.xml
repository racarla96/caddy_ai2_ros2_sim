<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>caddy_ai2_ros2_sim</name>
  <version>0.1.0</version>
  <description>
    Integration meta-package for the Caddy AI2 agricultural robot in simulation.
    Entry point: sim.launch.py starts Gazebo Harmonic, the robot, the EKF and, optionally, EasyNav.
  </description>
  <maintainer email="rafapenya96@gmail.com">Rafael Carbonell Lázaro</maintainer>
  <license>CC-BY-4.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Robot description and shared parameters -->
  <exec_depend>caddy_ai2_ros2_description</exec_depend>
  <exec_depend>caddy_ai2_ros2_robot_description_publisher</exec_depend>

  <!-- Kinematic adapters (simulation only — replaced by HW drivers on real robot) -->
  <exec_depend>caddy_ai2_ros2_bicycle_to_ackermann_steering_adapter</exec_depend>
  <exec_depend>caddy_ai2_ros2_bicycle_to_ackermann_traction_adapter</exec_depend>

  <!-- Simulator backend -->
  <exec_depend>caddy_ai2_ros2_gazebo_simulation</exec_depend>

  <!-- Sensors on the robot (see caddy_ai2_ros2_description/bringup/config/robot_params.yaml) -->
  <exec_depend>caddy_ai2_ros2_control_sensors_sbg_ig_500n</exec_depend>
  <exec_depend>caddy_ai2_ros2_sensors_lidar_sick_lms_291</exec_depend>
  <exec_depend>caddy_ai2_ros2_sensors_rs_helios_5515</exec_depend>

  <!-- EKF (odom -> base_footprint) and EasyNav navigation, started by sim.launch.py -->
  <exec_depend>caddy_ai2_ros2_localization</exec_depend>
  <exec_depend>caddy_ai2_ros2_navigation</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
